__pycache__/
*.py[cod]
.pytest_cache/
venv/
env/
*.egg-info/

# Generated / local-only
output/
logs/
data/uploaded.csv
.env
.env.local

# Docs and misc dev files
*.md
*.bat
tests/
backend/tests/
