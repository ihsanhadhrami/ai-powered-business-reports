# Requests always go to same-origin /api/* (proxied to the backend in dev by
# vite.config.ts, and by the Cloudflare Worker in production). Only override
# this if the frontend is served from somewhere that can't proxy for you.
# VITE_API_BASE_URL=

# Only needed if the backend's API_AUTH_TOKEN is set.
# VITE_API_KEY=
